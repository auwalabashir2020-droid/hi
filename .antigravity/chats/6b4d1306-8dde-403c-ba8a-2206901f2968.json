      "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Tailor Measurement Book</title>\n<style>\n:root{--bg:#f4f6f8;--card:#fff;--ink:#17212b;--muted:#657381;--accent:#203e5a;--line:#e2e8ee;--pink:#9d476d}\n*{box-sizing:border-box}body{margin:0;font-family:system-ui,-apple-system,Segoe UI,Roboto,sans-serif;background:var(--bg);color:var(--ink)}\nheader{background:linear-gradient(135deg,#18354d,#345b76);color:white;padding:24px 18px 22px;border-radius:0 0 24px 24px}\nheader h1{margin:0;font-size:24px}header p{margin:6px 0 0;color:#d5e3ed;font-size:14px}\nmain{max-width:720px;margin:auto;padding:16px}\n.tabs{display:flex;background:#e4eaf0;padding:4px;border-radius:14px;margin:4px 0 16px}.tabs button{flex:1;border:0;padding:12px;border-radius:11px;background:transparent;font-weight:700;color:var(--muted);font-size:15px}.tabs button.active{background:white;color:var(--ink);box-shadow:0 2px 6px #0001}\n.card{background:var(--card);border:1px solid var(--line);border-radius:18px;padding:16px;margin-bottom:14px;box-shadow:0 3px 12px #132b3b08}\nh2{font-size:18px;margin:0 0 12px}label{display:block;font-size:13px;color:var(--muted);font-weight:600;margin:10px 0 5px}\ninput,select,textarea{width:100%;padding:12px;border:1px solid var(--line);border-radius:11px;background:white;color:var(--ink);font:inherit;font-size:16px;outline:none}input:focus,select:focus,textarea:focus{border-color:#5e8eaf;box-shadow:0 0 0 3px #5e8eaf20}\n.grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}.measure{background:#f8fafb;padding:10px;border-radius:13px;border:1px solid #edf1f4}.measure label{margin:0 0 5px;color:#3e5364}.measure input{padding:10px}\nbutton.action{border:0;border-radius:12px;padding:13px 16px;background:var(--accent);color:white;font-weight:700;font-size:15px;width:100%;margin-top:14px}button.secondary{background:#edf2f6;color:#23394b}button.danger{background:#fff0f0;color:#a33333}\n.tools{display:flex;gap:9px;flex-wrap:wrap}.tools button{flex:1;min-width:110px;border:0;border-radius:10px;padding:10px;font-weight:650;background:#edf2f6;color:#253d50}\n.customer{border:1px solid var(--line);border-radius:14px;padding:13px;margin:10px 0}.customer h3{margin:0;font-size:16px}.customer small{color:var(--muted)}.customer .data{display:grid;grid-template-columns:1fr 1fr;gap:6px;margin-top:10px;font-size:13px}.customer .data span{background:#f7f9fa;padding:7px;border-radius:8px}\n.actions{display:flex;gap:8px;margin-top:10px}.actions button{flex:1;padding:9px;border:0;border-radius:9px;font-weight:650}.edit{background:#eaf2f8;color:#254b66}.del{background:#fff0f0;color:#9a3030}\n.hidden{display:none}.empty{text-align:center;padding:22px;color:var(--muted)}footer{text-align:center;color:var(--muted);font-size:12px;padding:12px}\n@media(min-width:600px){.grid{grid-template-columns:repeat(3,1fr)}}\n</style>\n</head>\n<body>\n<header><h1>🧵 Measurement Book</h1><p>Your digital customer measurement notebook</p></header>\n<main>\n<div class=\"tabs\"><button id=\"menTab\" class=\"active\" onclick=\"setType('men')\">Men</button><button id=\"womenTab\" onclick=\"setType('women')\">Women</button></div>\n<section class=\"card\">\n<h2 id=\"formTitle\">Add Men's Customer</h2>\n<input id=\"editId\" type=\"hidden\">\n<label>Customer name *</label><input id=\"name\" placeholder=\"Enter customer name\">\n<label>Phone number</label><input id=\"phone\" type=\"tel\" placeholder=\"Optional phone number\">\n<label>Measurement unit</label><select id=\"unit\"><option value=\"in\">Inches</option><option value=\"cm\">Centimeters</option></select>\n<div class=\"grid\" id=\"fields\"></div>\n<label>Notes / style details</label><textarea id=\"notes\" rows=\"2\" placeholder=\"Fabric, style, fitting notes…\"></textarea>\n<button class=\"action\" onclick=\"saveCustomer()\">Save measurements</button>\n<button class=\"action secondary hidden\" id=\"cancelEdit\" onclick=\"resetForm()\">Cancel editing</button>\n</section>\n<section class=\"card\">\n<h2>Customers</h2><input id=\"search\" placeholder=\"🔎 Search by name or phone\" oninput=\"renderCustomers()\">\n<div class=\"tools\" style=\"margin-top:12px\"><button onclick=\"exportData()\">Export backup</button><button onclick=\"importFile.click()\">Import backup</button><input id=\"importFile\" type=\"file\" accept=\".json,application/json\" style=\"display:none\" onchange=\"importData(event)\"></div>\n<div id=\"list\"></div>\n</section>\n<footer>Measurements are saved on this device in your browser.</footer>\n</main>\n<script>\nconst fieldsByType={men:[[\"SH\",\"Shoulder\"],[\"HN\",\"HN\"],[\"BL\",\"Body length\"],[\"TL\",\"Trouser length\"],[\"N\",\"Neck\"],[\"CH\",\"Chest\"]],women:[[\"BUS\",\"Bust\"],[\"SP\",\"Shoulder\"],[\"BL\",\"Body length\"],[\"HIPS\",\"Hips\"],[\"SLV\",\"Sleeve\"],[\"GOWN\",\"Gown length\"],[\"SL\",\"Skirt length\"]]};\nlet type=\"men\",customers=JSON.parse(localStorage.getItem(\"tailorBook_v1\")||\"[]\");\nfunction setType(t){type=t;menTab.classList.toggle(\"active\",t===\"men\");womenTab.classList.toggle(\"active\",t===\"women\");formTitle.textContent=\"Add \"+(t===\"men\"?\"Men's\":\"Women's\")+\" Customer\";renderFields();renderCustomers();resetForm(false)}\nfunction renderFields(values={}){fields.innerHTML=fieldsByType[type].map(([code,label])=>`<div class=\"measure\"><label>${code} · ${label}</label><input inputmode=\"decimal\" id=\"m_${code}\" placeholder=\"${code}\" value=\"${values[code]||\"\"}\"></div>`).join(\"\")}\nfunction saveCustomer(){let nameVal=name.value.trim();if(!nameVal){alert(\"Please enter the customer's name.\");name.focus();return}let measurements={};fieldsByType[type].forEach(([code])=>measurements[code]=document.getElementById(\"m_\"+code).value.trim());let id=editId.value||String(Date.now());let record={id,type,name:nameVal,phone:phone.value.trim(),unit:unit.value,measurements,notes:notes.value.trim(),updated:new Date().toISOString()};let idx=customers.findIndex(c=>c.id===id);if(idx>=0)customers[idx]=record;else customers.unshift(record);persist();resetForm();renderCustomers()}\nfunction persist(){localStorage.setItem(\"tailorBook_v1\",JSON.stringify(customers))}\nfunction resetForm(clear=true){if(clear){editId.value=\"\";name.value=\"\";phone.value=\"\";unit.value=\"in\";notes.value=\"\";formTitle.textContent=\"Add \"+(type===\"men\"?\"Men's\":\"Women's\")+\" Customer\";cancelEdit.classList.add(\"hidden\")}renderFields()}\nfunction renderCustomers(){let q=search.value.toLowerCase().trim();let filtered=customers.filter(c=>c.type===type&&(c.name.toLowerCase().includes(q)||(c.phone||\"\").includes(q)));list.innerHTML=filtered.length?filtered.map(c=>`<div class=\"customer\"><h3>${esc(c.name)}</h3><small>${esc(c.phone||\"No phone\")} · ${c.unit===\"cm\"?\"cm\":\"in\"} · ${new Date(c.updated).toLocaleDateString()}</small><div class=\"data\">${fieldsByType[c.type].map(([code,label])=>`<span><b>${code}</b>: ${esc(c.measurements[code]||\"—\")}</span>`).join(\"\")}</div>${c.notes?`<p style=\"font-size:13px;color:#536373;margin:10px 0 0\">📝 ${esc(c.notes)}</p>`:\"\"}<div class=\"actions\"><button class=\"edit\" onclick=\"editCustomer('${c.id}')\">Edit</button><button class=\"del\" onclick=\"deleteCustomer('${c.id}')\">Delete</button></div></div>`).join(\"\"):`<div class=\"empty\">No customers yet. Add your first measurement above.</div>`}\nfunction editCustomer(id){let c=customers.find(x=>x.id===id);if(!c)return;type=c.type;menTab.classList.toggle(\"active\",type===\"men\");womenTab.classList.toggle(\"active\",type===\"women\");editId.value=c.id;name.value=c.name;phone.value=c.phone||\"\";unit.value=c.unit||\"in\";notes.value=c.notes||\"\";formTitle.textContent=\"Edit \"+c.name;cancelEdit.classList.remove(\"hidden\");renderFields(c.measurements);window.scrollTo({top:0,behavior:\"smooth\"})}\nfunction deleteCustomer(id){if(confirm(\"Delete this customer's measurements?\")){customers=customers.filter(c=>c.id!==id);persist();renderCustomers()}}\nfunction esc(s){return String(s??\"\").replace(/[&<>\"']/g,ch=>({\"&\":\"&amp;\",\"<\":\"&lt;\",\">\":\"&gt;\",'\"':\"&quot;\",\"'\":\"&#39;\"}[ch]))}\nfunction exportData(){let blob=new Blob([JSON.stringify(customers,null,2)],{type:\"application/json\"});let a=document.createElement(\"a\");a.href=URL.createObjectURL(blob);a.download=\"tailor-measurements-backup.json\";a.click();URL.revokeObjectURL(a.href)}\nfunction importData(e){let f=e.target.files[0];if(!f)return;let r=new FileReader();r.onload=()=>{try{let incoming=JSON.parse(r.result);if(!Array.isArray(incoming))throw Error();customers=incoming;persist();renderCustomers();alert(\"Backup imported.\")}catch{alert(\"Invalid backup file.\")}};r.readAsText(f);e.target.value=\"\"}\nrenderFields();renderCustomers();\n</script>\n</body>\n</html>",
